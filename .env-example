# Orchestrator GitHub API (fetch terraplane.yaml, PR head SHA)
ORCHESTRATOR_GITHUB_ACCESS_TOKEN=
ORCHESTRATOR_GITHUB_WEBHOOK_SECRET=

# Orchestrator database (postgres or mysql)
DATABASE_DRIVER=postgres
DATABASE_URL=postgres://terraplane:terraplane@postgres:5432/terraplane?sslmode=disable

# Agent deploy key — host path (docker-compose bind-mounts into the container)
AGENT_SCM_SSH_KEY_PATH=/path/to/deploy_key

SHARED_AUTH_TOKEN=shared_secret